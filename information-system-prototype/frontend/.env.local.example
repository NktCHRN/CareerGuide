# ============================================================================
#  CareerGuide frontend — example local environment  (copy: cp .env.local.example .env.local)
# ----------------------------------------------------------------------------
#  The frontend is a BFF: the browser talks only to Next.js (route handlers,
#  Server Components, Server Actions); Next.js talks to the API Gateway and
#  attaches the JWT (stored in httpOnly cookies) server-side.
# ============================================================================

# Base URL of the API Gateway (the single public entry point for all services).
# Used SERVER-SIDE only. In Docker/K8s set this to the gateway's internal URL.
GATEWAY_URL=http://localhost:8000

# Optional: shown in the UI footer / health badge. Not required.
# NEXT_PUBLIC_APP_NAME=CareerGuide

# Cookie security. Set to "true" behind HTTPS in production so auth cookies are
# flagged Secure. Leave false for local http://localhost development.
COOKIE_SECURE=false
