# ============================================================================
#  CareerGuide — приклад КОРЕНЕВОГО .env       (скопіюй:  cp .env.example .env)
# ----------------------------------------------------------------------------
#  Цей файл читають УСІ компоненти монорепо:
#   • Локальний запуск (uvicorn): значення нижче налаштовані на localhost —
#     сервіси ходять у спільну інфру через ПРОКИНУТІ назовні порти
#     (Kafka 29092, MinIO 9000, Redis 6379).
#   • Docker: кожен per-service docker-compose.yml підвантажує цей файл
#     (env_file: ../../.env), але ПЕРЕВИЗНАЧАЄ хости на внутрішні docker-імена
#     (kafka:9092 / redis:6379 / minio:9000 / <service>db:5432) у блоці
#     `environment:`. Тому тут лишаються localhost-значення.
#
#  .env НЕ комітиться — у git зберігається лише цей .env.example.
# ============================================================================

# --- Загальні налаштування застосунку ---
APP_ENV=dev                       # dev | prod (у dev ендпойнти можуть повертати токени листів у відповіді)
AUTH_MODE=local                   # local — ізольований dev сервіса (сам валідує JWT);
                                  # gateway — K8s/прод (довіра заголовкам X-User-Id / X-User-Role від API Gateway)
CORS_ORIGINS=http://localhost:3000

# --- JWT (спільний секрет; access-токени видає ЛИШЕ user-service, алгоритм HS256) ---
JWT_SECRET=change-me-dev-secret-rotate-in-prod

# --- PostgreSQL (database-per-service) ---
# Спільні креди. Назва БД та хост — у кожного сервіса свої (userdb / careerdb /
# chatdb / recommendationdb). Повний DATABASE_URL збирається в per-service
# docker-compose.yml з цих значень:
#   postgresql+asyncpg://<user>:<pass>@<service>db:5432/<db>
POSTGRES_USER=career
POSTGRES_PASSWORD=career

# --- Kafka (Message Bus, клієнт aiokafka) ---
# Docker: kafka:9092      |      локально: localhost:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- Redis (in-memory кеш, TTL) ---
# Docker: redis://redis:6379/0      |      локально: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# --- S3 / MinIO (об'єктне сховище, boto3 з endpoint_url) ---
# Docker: http://minio:9000      |      локально: http://localhost:9000
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=career-guide
S3_REGION=us-east-1

# --- OpenAI / LLM ---
# recommendation-worker — парсинг резюме; chat-service — асистент.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email / AWS SES (ЛИШЕ user-service; за фіче-флагом, default ВИМКНЕНО) ---
FEATURE_EMAIL_ENABLED=false       # false: листи не надсилаються (у dev токен/посилання повертається у відповіді)
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@career-guide.local

# --- Сідинг початкових акаунтів (alembic-сідинг user-service) ---
SEED_ADMIN_EMAIL=admin@career-guide.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Administrator
SEED_USER_EMAIL=user@career-guide.local
SEED_USER_PASSWORD=user12345
SEED_USER_NAME=Test User

# ============================================================================
#  recommendation-worker — моделі, ML-артефакти та дані
#  Шляхи відносні до каталогу worker (backend/recommendation-service/worker).
#  Великі файли (.pth, CSV) кладуться ВРУЧНУ і не комітяться (див. .gitignore).
# ============================================================================
MODEL_CKPT_PATH=./models/gru-attn-bidirectional-final_seed4.pth   # чекпойнт GRU-рекомендатора
INDUSTRY_VOCAB_PATH=./models/industry_to_id.json                  # словник industry → id
LIVECAREER_CATEGORIES_PATH=./data/livecareer_resume_categories.csv
ESCO_SKILLS_CSV=./data/skills_en.csv                              # ESCO-навички для мапінгу

# SBERT-модель: ембединг резюме у вектор для GRU-рекомендатора
SBERT_MODEL=ElenaSenger/career-path-representation-mpnet-decorte
# Модель ембедингу для мапінгу вільних навичок користувача в ESCO
# (gated-модель → обов'язковий HF_TOKEN)
ESCO_SKILL_EMBED_MODEL=google/embeddinggemma-300m

# Hugging Face токен (для gated-моделей, напр. embeddinggemma). https://hf.co/settings/tokens
HF_TOKEN=
