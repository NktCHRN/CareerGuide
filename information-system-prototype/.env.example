# ============================================================================
#  CareerGuide — example ROOT .env       (copy:  cp .env.example .env)
# ----------------------------------------------------------------------------
#  This file is read by ALL components of the monorepo:
#   • Local run (uvicorn): the values below are set for localhost —
#     services reach the shared infra through the ports EXPOSED to the outside
#     (Kafka 29092, MinIO 9000, Redis 6379).
#   • Docker: each per-service docker-compose.yml loads this file
#     (env_file: ../../.env), but OVERRIDES the hosts with the internal docker
#     names (postgres:5432 / kafka:9092 / redis:6379 / minio:9000) in the
#     `environment:` block. That is why the localhost values stay here.
#
#  .env is NOT committed — only this .env.example is kept in git.
# ============================================================================

# --- General application settings ---
APP_ENV=dev                       # dev | prod (in dev the endpoints may return email tokens in the response)
AUTH_MODE=local                   # local — isolated dev of a service (validates the JWT itself);
                                  # gateway — K8s/prod (trusts the X-User-Id / X-User-Role headers from the API Gateway)
CORS_ORIGINS=http://localhost:3000

# --- JWT (shared secret; access tokens are issued ONLY by user-service, HS256 algorithm) ---
JWT_SECRET=change-me-dev-secret-rotate-in-prod

# --- API Gateway (single public entry point, port 8000) ---
# Downstream service URLs. Local run → localhost ports (below); in Docker the
# gateway's docker-compose.yml overrides these with the container names
# (http://career-user-service:8001 etc.). The gateway validates the JWT and
# forwards X-User-Id / X-User-Role, so the services run with AUTH_MODE=gateway.
USER_SERVICE_URL=http://localhost:8001
CAREER_SERVICE_URL=http://localhost:8002
RECO_API_URL=http://localhost:8003
CHAT_SERVICE_URL=http://localhost:8004
GATEWAY_VERIFY_VIA_USER_SERVICE=false   # optional: also confirm the user via user-service

# --- PostgreSQL (single shared instance, one logical DB per service) ---
# Shared credentials and host. One Postgres server holds userdb / careerdb / chatdb /
# recommendationdb. Each service's DATABASE_URL is assembled in its docker-compose.yml:
#   Docker:  postgresql+asyncpg://<user>:<pass>@postgres:5432/<db>
#   locally: postgresql+asyncpg://<user>:<pass>@localhost:5432/<db>
POSTGRES_USER=career
POSTGRES_PASSWORD=career

# --- Kafka (Message Bus, aiokafka client) ---
# Docker: kafka:9092      |      locally: localhost:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- Redis (in-memory cache, TTL) ---
# Docker: redis://redis:6379/0      |      locally: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# --- S3 / MinIO (object storage, boto3 with endpoint_url) ---
# Docker: http://minio:9000      |      locally: http://localhost:9000
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=career-guide
S3_REGION=us-east-1

# --- OpenAI / LLM ---
# recommendation-worker — resume parsing; chat-service — assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email / AWS SES (ONLY user-service; behind a feature flag, default DISABLED) ---
FEATURE_EMAIL_ENABLED=false       # false: emails are not sent (in dev the token/link is returned in the response)
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@career-guide.local

# --- Seeding of initial accounts (alembic seeding of user-service) ---
SEED_ADMIN_EMAIL=admin@career-guide.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Administrator
SEED_USER_EMAIL=user@career-guide.local
SEED_USER_PASSWORD=user12345
SEED_USER_NAME=Test User

# ============================================================================
#  recommendation-worker — models, ML artifacts and data
#  Paths are relative to the worker directory (backend/recommendation-service/worker).
#  Large files (.pth, CSV) are placed MANUALLY and are not committed (see .gitignore).
# ============================================================================
MODEL_CKPT_PATH=./models/gru-attn-bidirectional-final_seed4.pth   # GRU recommender checkpoint
INDUSTRY_VOCAB_PATH=./models/industry_to_id.json                  # industry → id vocabulary
LIVECAREER_CATEGORIES_PATH=./data/livecareer_resume_categories.csv
ESCO_SKILLS_CSV=./data/skills_en.csv                              # ESCO skills for mapping

# SBERT model: embedding of a resume into a vector for the GRU recommender
SBERT_MODEL=ElenaSenger/career-path-representation-mpnet-decorte
# Embedding model for mapping the user's free-form skills to ESCO
# (gated model → HF_TOKEN required)
ESCO_SKILL_EMBED_MODEL=google/embeddinggemma-300m

# Hugging Face token (for gated models, e.g. embeddinggemma). https://hf.co/settings/tokens
HF_TOKEN=
