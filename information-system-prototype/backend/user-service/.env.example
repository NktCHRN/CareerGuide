# ============================================================================
#  user-service — example .env (optional)
# ----------------------------------------------------------------------------
#  By default the service reads the monorepo ROOT .env (../../.env). This file
#  is only needed if you want to run user-service IN ISOLATION with your own
#  values: copy it to `.env` in this directory — they override the root ones.
#
#      cp .env.example .env
#
#  The values below are tuned for a local run (uvicorn) against the shared
#  infra with externally exposed ports (Kafka 29092, MinIO 9000, Redis 6379).
# ============================================================================

APP_ENV=dev
AUTH_MODE=local                 # local — validates JWT itself; gateway — trusts X-User-* from the API Gateway
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=change-me-dev-secret-rotate-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql+asyncpg://career:career@localhost:5432/userdb

KAFKA_BOOTSTRAP_SERVERS=localhost:29092
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=career-guide
S3_REGION=us-east-1

# --- Email / AWS SES (feature flag, default off) ---
FEATURE_EMAIL_ENABLED=false
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@career-guide.local
FRONTEND_BASE_URL=http://localhost:3000

# --- Seeding initial accounts (alembic) ---
SEED_ADMIN_EMAIL=admin@career-guide.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Administrator
SEED_USER_EMAIL=user@career-guide.local
SEED_USER_PASSWORD=user12345
SEED_USER_NAME=Test User
