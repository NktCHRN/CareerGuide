# ============================================================================
#  user-service — приклад .env (опційний)
# ----------------------------------------------------------------------------
#  За замовчуванням сервіс читає КОРЕНЕВИЙ .env монорепо (../../.env). Цей файл
#  потрібен, лише якщо хочеш запускати user-service ІЗОЛЬОВАНО з власними
#  значеннями: скопіюй у `.env` у цьому каталозі — вони перекриють кореневі.
#
#      cp .env.example .env
#
#  Значення нижче налаштовані на локальний запуск (uvicorn) проти спільної
#  інфри з прокинутими назовні портами (Kafka 29092, MinIO 9000, Redis 6379).
# ============================================================================

APP_ENV=dev
AUTH_MODE=local                 # local — сам валідує JWT; gateway — довіра X-User-* від API Gateway
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=change-me-dev-secret-rotate-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql+asyncpg://career:career@localhost:5433/userdb

KAFKA_BOOTSTRAP_SERVERS=localhost:29092
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=career-guide
S3_REGION=us-east-1

# --- Email / AWS SES (фіче-флаг, default off) ---
FEATURE_EMAIL_ENABLED=false
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@career-guide.local
FRONTEND_BASE_URL=http://localhost:3000

# --- Сідинг початкових акаунтів (alembic) ---
SEED_ADMIN_EMAIL=admin@career-guide.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Administrator
SEED_USER_EMAIL=user@career-guide.local
SEED_USER_PASSWORD=user12345
SEED_USER_NAME=Test User
