# ============================================================================
#  api-gateway — example .env (optional)
# ----------------------------------------------------------------------------
#  By default the service reads the monorepo ROOT .env (../../.env). This file
#  is only needed if you want to run api-gateway IN ISOLATION with your own
#  values: copy it to `.env` in this directory — they override the root ones.
#
#      cp .env.example .env
#
#  The values below are tuned for a local run (uvicorn): the gateway reaches the
#  downstream services on their externally exposed localhost ports.
# ============================================================================

APP_ENV=dev
CORS_ORIGINS=http://localhost:3000

# JWT — shared secret; the gateway only VALIDATES tokens (user-service issues them).
JWT_SECRET=change-me-dev-secret-rotate-in-prod

# Downstream services (local run → localhost ports; in Docker the compose file
# overrides these with the internal names: http://user-service:8001 etc.).
USER_SERVICE_URL=http://localhost:8001
CAREER_SERVICE_URL=http://localhost:8002
RECO_API_URL=http://localhost:8003
CHAT_SERVICE_URL=http://localhost:8004

# Reverse-proxy timeouts/retries.
PROXY_CONNECT_TIMEOUT_SECONDS=5.0
PROXY_TIMEOUT_SECONDS=60.0
PROXY_RETRIES=1

# Optional: after local JWT validation, also confirm the user via user-service
# (GET /api/profile/me). Default off — local validation is enough for the prototype.
GATEWAY_VERIFY_VIA_USER_SERVICE=false
