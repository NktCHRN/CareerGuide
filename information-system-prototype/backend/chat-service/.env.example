# ============================================================================
#  chat-service — example .env (optional)
# ----------------------------------------------------------------------------
#  By default the service reads the monorepo ROOT .env (../../.env). This file
#  is only needed if you want to run chat-service IN ISOLATION with your own
#  values: copy it to `.env` in this directory — they override the root ones.
#
#      cp .env.example .env
#
#  The values below are tuned for a local run (uvicorn) against the shared
#  infra with externally exposed ports (Postgres 5432, Kafka 29092).
# ============================================================================

APP_ENV=dev
AUTH_MODE=local                 # local — validates JWT itself; gateway — trusts X-User-* from the API Gateway
CORS_ORIGINS=http://localhost:3000

# JWT — shared secret; chat-service only VALIDATES tokens (user-service issues them).
JWT_SECRET=change-me-dev-secret-rotate-in-prod

DATABASE_URL=postgresql+asyncpg://career:career@localhost:5432/chatdb

KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Separate consumer groups, one per consumed topic.
KAFKA_GROUP_PROFESSIONS=chat-prof
KAFKA_GROUP_USERS=chat-user

# OpenAI assistant (required for real replies; without a key the service returns a fallback).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=900

# How many recent messages of a chat are sent to the model as history.
CHAT_HISTORY_LIMIT=20
