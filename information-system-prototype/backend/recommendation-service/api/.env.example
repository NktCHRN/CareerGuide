# ============================================================================
#  recommendation-api — example .env (optional)
# ----------------------------------------------------------------------------
#  By default the service reads the monorepo ROOT .env (../../../.env). This file
#  is only needed to run recommendation-api IN ISOLATION with your own values:
#  copy it to `.env` in this directory — they override the root ones.
#
#      cp .env.example .env
#
#  The values below are tuned for a local run (uvicorn) against the shared infra
#  with externally exposed ports (Postgres 5432, Redis 6379). recommendation-api
#  is READ-ONLY over recommendationdb — the worker owns the schema/migrations.
# ============================================================================

APP_ENV=dev
AUTH_MODE=local                 # local — validates JWT itself; gateway — trusts X-User-* from the API Gateway
CORS_ORIGINS=http://localhost:3000

# JWT — shared secret; recommendation-api only VALIDATES tokens (user-service issues them).
JWT_SECRET=change-me-dev-secret-rotate-in-prod

# recommendationdb (shared instance, pgvector). Docker: ...@postgres:5432/recommendationdb
DATABASE_URL=postgresql+asyncpg://career:career@localhost:5432/recommendationdb

# Redis cache for the first recommendation page. Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
RECO_CACHE_TTL_SECONDS=300

# Max number of profession_ids accepted by POST /api/recommendations/scores.
MAX_SCORE_IDS=200
