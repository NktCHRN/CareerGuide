# ============================================================================
#  recommendation-worker — example .env   (copy:  cp .env.example .env)
# ----------------------------------------------------------------------------
#  Most values are normally inherited from the monorepo ROOT .env (the worker
#  reads ../../../.env too). This local file is handy for isolated dev of just
#  the worker. In Docker the hosts are overridden with the internal names
#  (postgres / kafka / minio) in docker-compose.yml.
# ============================================================================

# --- General ---
APP_ENV=dev
HEALTH_PORT=8005
DEVICE=auto                       # auto | cpu | cuda

# --- PostgreSQL (recommendationdb in the shared instance; pgvector enabled) ---
# Docker:  postgresql+asyncpg://career:career@postgres:5432/recommendationdb
DATABASE_URL=postgresql+asyncpg://career:career@localhost:5432/recommendationdb

# --- Kafka (Message Bus) ---
# Docker: kafka:9092   |   locally: localhost:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- S3 / MinIO (resume PDFs, read-only) ---
# Docker: http://minio:9000   |   locally: http://localhost:9000
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=career-guide
S3_REGION=us-east-1

# --- OpenAI (resume parsing) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- career-SBERT: role/skill/summary/profession embeddings fed to CareerRNN ---
SBERT_MODEL=ElenaSenger/career-path-representation-mpnet-decorte

# --- CareerRNN checkpoint + auxiliary vocab/data (relative to the worker dir) ---
MODEL_CKPT_PATH=./models/gru-attn-bidirectional-final_seed4.pth
INDUSTRY_VOCAB_PATH=./models/industry_to_id.json
LIVECAREER_CATEGORIES_PATH=./data/livecareer_resume_categories.csv

# --- ESCO skill mapping (v3): EmbeddingGemma over the full ESCO skill catalogue ---
ESCO_SKILLS_CSV=./data/skills_en.csv
ESCO_SKILL_EMBED_MODEL=google/embeddinggemma-300m
# EmbeddingGemma is gated — accept the license at
# https://huggingface.co/google/embeddinggemma-300m and set a token below.
HF_TOKEN=
