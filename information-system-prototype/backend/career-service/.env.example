# ============================================================================
#  career-service — example .env (optional)
# ----------------------------------------------------------------------------
#  By default the service reads the monorepo ROOT .env (../../.env). This file
#  is only needed if you want to run career-service IN ISOLATION with your own
#  values: copy it to `.env` in this directory — they override the root ones.
#
#      cp .env.example .env
#
#  The values below are tuned for a local run (uvicorn) against the shared
#  infra with externally exposed ports (Postgres 5432, Kafka 29092, MinIO 9000,
#  Redis 6379).
# ============================================================================

APP_ENV=dev
AUTH_MODE=local                 # local — validates JWT itself; gateway — trusts X-User-* from the API Gateway
CORS_ORIGINS=http://localhost:3000

# JWT — shared secret; career-service only VALIDATES tokens (user-service issues them).
JWT_SECRET=change-me-dev-secret-rotate-in-prod

DATABASE_URL=postgresql+asyncpg://career:career@localhost:5432/careerdb

KAFKA_BOOTSTRAP_SERVERS=localhost:29092
REDIS_URL=redis://localhost:6379/0
PROFESSION_CACHE_TTL_SECONDS=600

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=career-guide
S3_REGION=us-east-1
PHOTO_PRESIGN_TTL_SECONDS=3600

# ESCO CSVs for the seeding migration (occupations_en.csv / skills_en.csv /
# occupationSkillRelations_en.csv). Local run: ./data/esco; Docker: /app/data/esco.
ESCO_DATA_DIR=./data/esco
